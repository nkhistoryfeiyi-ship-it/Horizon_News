{
  "version": "1.0",
  "ai": {
    "provider": "openai",
    "model": "agnes-2.0-flash",
    "api_key_env": "AGNES_API_KEY",
    "base_url": "https://apihub.agnes-ai.com/v1",
    "temperature": 0.3,
    "max_tokens": 4096,
    "throttle_sec": 2,
    "analysis_concurrency": 1,
    "enrichment_concurrency": 1,
    "languages": ["en", "zh", "ja"]
  },
  "sources": {
    "hackernews": {
      "enabled": true,
      "fetch_top_stories": 30,
      "min_score": 100
    },
    "rss": [
      {
        "name": "South China Morning Post",
        "url": "https://www.scmp.com/rss/91/feed",
        "enabled": true,
        "category": "china-news"
      },
      {
        "name": "Reuters China",
        "url": "https://www.reuters.com/arc/outboundfeeds/v4/section/china/?outputType=xml",
        "enabled": true,
        "category": "china-news"
      },
      {
        "name": "BBC News China",
        "url": "https://feeds.bbci.co.uk/news/world/asia/china/rss.xml",
        "enabled": true,
        "category": "china-news"
      },
      {
        "name": "The Guardian China",
        "url": "https://www.theguardian.com/world/china/rss",
        "enabled": true,
        "category": "china-news"
      },
      {
        "name": "Nikkei Asia China",
        "url": "https://asia.nikkei.com/rss/feed/nar?category=China",
        "enabled": true,
        "category": "china-news"
      },
      {
        "name": "FT China",
        "url": "https://www.ft.com/chinese-economy?format=rss",
        "enabled": true,
        "category": "china-economy"
      },
      {
        "name": "Bloomberg China Economy",
        "url": "https://feeds.bloomberg.com/markets/news.rss",
        "enabled": true,
        "category": "china-economy"
      },
      {
        "name": "Simon Willison",
        "url": "https://simonwillison.net/atom/everything/",
        "enabled": true,
        "category": "ai-tools"
      },
      {
        "name": "The Verge",
        "url": "https://www.theverge.com/rss/index.xml",
        "enabled": true,
        "category": "tech-news"
      },
      {
        "name": "Ars Technica",
        "url": "https://feeds.arstechnica.com/arstechnica/index",
        "enabled": true,
        "category": "tech-news"
      },
      {
        "name": "TechCrunch",
        "url": "https://techcrunch.com/feed/",
        "enabled": true,
        "category": "tech-news"
      },
      {
        "name": "MIT Technology Review",
        "url": "https://www.technologyreview.com/feed/",
        "enabled": true,
        "category": "tech-news"
      }
    ],
    "reddit": {
      "enabled": true,
      "subreddits": [
        {
          "subreddit": "China",
          "enabled": true,
          "sort": "hot",
          "time_filter": "day",
          "fetch_limit": 20,
          "min_score": 30
        },
        {
          "subreddit": "geopolitics",
          "enabled": true,
          "sort": "hot",
          "time_filter": "day",
          "fetch_limit": 15,
          "min_score": 50
        },
        {
          "subreddit": "worldnews",
          "enabled": true,
          "sort": "hot",
          "time_filter": "day",
          "fetch_limit": 15,
          "min_score": 200
        },
        {
          "subreddit": "economics",
          "enabled": true,
          "sort": "hot",
          "time_filter": "day",
          "fetch_limit": 15,
          "min_score": 50
        },
        {
          "subreddit": "MachineLearning",
          "enabled": true,
          "sort": "hot",
          "time_filter": "day",
          "fetch_limit": 15,
          "min_score": 50
        },
        {
          "subreddit": "LocalLLaMA",
          "enabled": true,
          "sort": "hot",
          "time_filter": "day",
          "fetch_limit": 15,
          "min_score": 30
        },
        {
          "subreddit": "technology",
          "enabled": true,
          "sort": "hot",
          "time_filter": "day",
          "fetch_limit": 15,
          "min_score": 100
        },
        {
          "subreddit": "programming",
          "enabled": true,
          "sort": "hot",
          "time_filter": "day",
          "fetch_limit": 15,
          "min_score": 50
        }
      ],
      "users": [],
      "fetch_comments": 5
    },
    "telegram": {
      "enabled": true,
      "channels": [
        {
          "channel": "aigaboratory",
          "enabled": true,
          "fetch_limit": 20
        },
        {
          "channel": "OpenAINewsDaily",
          "enabled": true,
          "fetch_limit": 20
        }
      ]
    },
    "ossinsight": {
      "enabled": true,
      "period": "past_24_hours",
      "languages": ["All", "Python", "TypeScript", "Rust"],
      "keywords": [],
      "min_stars": 50,
      "max_items": 20
    },
    "gdelt": {
      "enabled": true,
      "query": "China economy OR China politics OR China trade OR China technology OR artificial intelligence",
      "mode": "ArtList",
      "max_records": 75,
      "timespan": null,
      "language": null,
      "country": null,
      "category": "news"
    },
    "google_news": {
      "enabled": true,
      "query": "China economy politics OR AI technology",
      "language": "en",
      "country": "US",
      "ceid": null,
      "max_results": 50,
      "category": "news"
    },
    "github": [],
    "twitter": {
      "enabled": false
    }
  },
  "filtering": {
    "ai_score_threshold": 6.0,
    "time_window_hours": 24,
    "max_items": null,
    "category_groups": {},
    "default_group": "other",
    "default_group_limit": null
  },
  "webhook": {
    "enabled": false
  }
}
